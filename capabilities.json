{
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Each point: one row per value",
      "displayNameKey": "Role_category",
      "descriptionKey": "RoleDesc_category"
    },
    {
      "displayName": "Legend",
      "displayNameKey": "Role_legend",
      "name": "legend",
      "kind": "Grouping",
      "description": "Colour the points by group (optional)",
      "descriptionKey": "RoleDesc_legend"
    },
    {
      "displayName": "X axis",
      "name": "xValue",
      "kind": "Measure",
      "description": "Horizontal position",
      "displayNameKey": "Role_xValue",
      "descriptionKey": "RoleDesc_xValue"
    },
    {
      "displayName": "Y axis",
      "name": "yValue",
      "kind": "Measure",
      "description": "Vertical position",
      "displayNameKey": "Role_yValue",
      "descriptionKey": "RoleDesc_yValue"
    },
    {
      "displayName": "Size",
      "name": "size",
      "kind": "Measure",
      "description": "Bubble size (optional)",
      "displayNameKey": "Role_size",
      "descriptionKey": "RoleDesc_size"
    },
    {
      "displayName": "Tooltips",
      "name": "tooltips",
      "kind": "Measure",
      "description": "Extra fields shown in the tooltip",
      "displayNameKey": "Role_tooltips",
      "descriptionKey": "RoleDesc_tooltips"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "xValue": {
            "max": 1
          },
          "yValue": {
            "max": 1
          },
          "size": {
            "max": 1
          },
          "tooltips": {
            "max": 10
          },
          "legend": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "bind": {
                "to": "category"
              }
            },
            {
              "bind": {
                "to": "legend"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "bind": {
                "to": "xValue"
              }
            },
            {
              "bind": {
                "to": "yValue"
              }
            },
            {
              "bind": {
                "to": "size"
              }
            },
            {
              "bind": {
                "to": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
